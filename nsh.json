{
  "name": "Safay",
  "id": "com.gicek.safay",
  "version": "1.4.0",
  "build": 13,
  "rust": ".",
  "root": "App",
  "appearance": "system",
  "capabilities": {
    "application": true,
    "clipboard": true,
    "fs": {
      "read": [
        "${dataDir}/exports"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "picker": true,
    "share": true,
    "statusBar": true,
    "windows": true
  },
  "theme": "theme.json",
  "icon": "assets/icon.png",
  "android": {
    "libraries": [
      "build/android/java/classes.dex"
    ],
    "permissions": [
      "USE_BIOMETRIC",
      "CAMERA"
    ]
  },
  "schemes": [
    "safay"
  ]
}
