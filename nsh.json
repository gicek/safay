{
  "name": "Safay",
  "id": "com.gicek.safay",
  "version": "1.5.0",
  "build": 14,
  "rust": ".",
  "root": "App",
  "appearance": "system",
  "capabilities": {
    "application": true,
    "clipboard": true,
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    },
    "picker": true,
    "share": true,
    "statusBar": true,
    "windows": true
  },
  "theme": "theme.json",
  "icon": "assets/icon.png",
  "ios": {
    "infoPlist": {
      "NSCameraUsageDescription": "Safay uses the camera to scan 2FA QR codes. Images are processed on this device only.",
      "NSFaceIDUsageDescription": "Safay uses Face ID to unlock your vault.",
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationPortrait"
      ]
    }
  },
  "android": {
    "targetSdk": 36,
    "libraries": [
      "build/android/java/classes.dex"
    ],
    "permissions": [
      "USE_BIOMETRIC",
      "CAMERA"
    ]
  },
  "schemes": [
    "safay"
  ]
}
