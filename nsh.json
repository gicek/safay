{
  "name": "Safay",
  "id": "com.gicek.safay",
  "version": "1.6.0",
  "build": 15,
  "rust": ".",
  "root": "App",
  "appearance": "system",
  "capabilities": {
    "application": true,
    "clipboard": true,
    "openUrl": {
      "schemes": [
        "https",
        "http",
        "dbapi-2",
        "dbapi-8-emm"
      ]
    },
    "picker": true,
    "share": true,
    "statusBar": true,
    "windows": true
  },
  "theme": "theme.json",
  "icon": "assets/icon.png",
  "ios": {
    "infoPlist": {
      "NSCameraUsageDescription": "Safay uses the camera to scan 2FA QR codes. Images are processed on this device only.",
      "NSFaceIDUsageDescription": "Safay uses Face ID to unlock your vault.",
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationPortrait"
      ],
      "LSApplicationQueriesSchemes": [
        "dbapi-2",
        "dbapi-8-emm"
      ]
    }
  },
  "android": {
    "targetSdk": 36,
    "libraries": [
      "build/android/java/classes.dex"
    ],
    "permissions": [
      "USE_BIOMETRIC",
      "CAMERA"
    ],
    "application": [
      "<activity android:name=\"com.gicek.safay.DropboxAuthActivity\" android:exported=\"true\" android:excludeFromRecents=\"true\" android:noHistory=\"true\" android:theme=\"@android:style/Theme.Translucent.NoTitleBar\"/>"
    ],
    "queries": [
      "<package android:name=\"com.dropbox.android\"/>"
    ]
  },
  "schemes": [
    "safay"
  ]
}
